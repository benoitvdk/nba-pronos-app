# Postgres connection URL provided by Neon (the "Connection Details" tab)
# format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Flask secret key (sessions, signed cookies) - generate one, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# theoddsapi.com API key (https://the-odds-api.com/)
ODDS_API_KEY=

# balldontlie.io API key (https://balldontlie.io -> Sign Up, free tier)
BALLDONTLIE_API_KEY=

# Environment (development / production)
FLASK_ENV=development

# Which competition the app runs: "playoffs" or "nba_cup" - never both at
# once (see README, "NBA Cup mode")
APP_MODE=playoffs
